# 论文全文再分发边界：arXiv e-print 原始包与解包内容一律不入仓
data/raw_eprint/
*.tar.gz
*.tex.bak

# Demo assets (regenerated)
docs/demo/*.gif
docs/demo/*.png

# Data (local only, not in repo)
data/real_papers/*.tex
data/real_papers/*.pdf
data/real_papers/*.gz
data/benchmark/snapshots/*.bin
