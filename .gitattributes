* text=auto eol=lf
*.py text=auto eol=lf
*.md text=auto eol=lf
*.json text=auto eol=lf
*.yaml text=auto eol=lf
*.yml text=auto eol=lf
*.tex text=auto eol=lf
*.html text=auto eol=lf
*.css text=auto eol=lf
*.js text=auto eol=lf
*.txt text=auto eol=lf

# Binary / frozen snapshots - must NOT be EOL-normalized
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
data/benchmark/snapshots/* binary
data/benchmark/samples/*/*.pdf binary

# Prevent CRLF on frozen fixtures
data/benchmark/truth.json text=auto eol=lf
data/benchmark/manifest.json text=auto eol=lf
